@@ -0,0 +1,80 @@
+import type {PrimitiveRenderContext} from 'openalgo-charts';
+import {WallLogicalMapping} from './wall-logical-mapping';
+
+export interface RetainedWallSpan {from:number;to:number;usd:number|null;percentile:number|null}
+interface Span extends RetainedWallSpan {left:number;right:number}
+interface Node {first:Bucket;last:Bucket;path:Path2D;minLength:number;left?:Node;right?:Node}
+interface Bucket {usd:number|null;percentile:number|null;spans:Span[];path:Path2D;minLength:number;maxLength:number}
+
+/** One exact, immutable price row in logical time coordinates. This contains no
+ * camera pixels: panning, DPR and price-scale changes never rewrite its paths.
+ * Buckets keep exact values (rather than pre-normalized contrast tiers).
+ * Short strokes are drawn separately at their mandated one-device-pixel width.
+ */
+export class RetainedWallPaths {
+  private constructor(readonly mapping:WallLogicalMapping,private readonly buckets:Bucket[],private readonly root:Node|undefined,readonly bytes:number){}
+
+  static *prepare(rc:PrimitiveRenderContext,spans:Iterable<RetainedWallSpan>,from:number,to:number):Generator<void,RetainedWallPaths|undefined> {
+    const mapping=WallLogicalMapping.capture(rc,from,to);if(!mapping)return;
+    const buckets=new Map<string,Bucket>();let bytes=mapping.bytes+128,units=0;
+    for(const span of spans){
+      if(!Number.isFinite(span.from)||!Number.isFinite(span.to)||span.to<span.from)return;
+      const left=mapping.logical(span.from),right=mapping.logical(span.to);if(left===undefined||right===undefined)return;
+      const key=`${span.usd}:${span.percentile}`;
+      let bucket=buckets.get(key);
+      if(!bucket){bucket={usd:span.usd,percentile:span.percentile,spans:[],path:new Path2D(),minLength:Infinity,maxLength:0};buckets.set(key,bucket);bytes+=256;}
+      bucket.spans.push({...span,left,right});bucket.path.moveTo(left,0);bucket.path.lineTo(right,0);
+      bucket.minLength=Math.min(bucket.minLength,right-left);bucket.maxLength=Math.max(bucket.maxLength,right-left);bytes+=96;
+      if(++units%32===0)yield;
+    }
+    const ordered=[...buckets.values()].sort((a,b)=>(a.usd??-Infinity)-(b.usd??-Infinity));
+    const tree=(from:number,to:number):Node|undefined=>{
+      if(from>=to)return;
+      const first=ordered[from]!,last=ordered[to-1]!;
+      if(to-from===1)return {first,last,path:first.path,minLength:first.minLength};
+      const mid=(from+to)>>>1,left=tree(from,mid)!,right=tree(mid,to)!,path=new Path2D();
+      path.addPath(left.path);path.addPath(right.path);
+      // Native Path2D owns copied commands. Charge each level explicitly.
+      let commands=0;for(let i=from;i<to;i++)commands+=ordered[i]!.spans.length;
+      bytes+=192+commands*64;
+      return {first,last,path,minLength:Math.min(left.minLength,right.minLength),left,right};
+    };
+    return new RetainedWallPaths(mapping,ordered,tree(0,ordered.length),bytes);
+  }
+
+  /** Returns false on a real mapping revision; callers must not paint known
+   * invalid geometry. Caller supplies the exact chart priceToY result, including
+   * logarithmic and rebased modes. No native-price affine approximation. */
+  paint(ctx:CanvasRenderingContext2D,rc:PrimitiveRenderContext,y:number,style:(usd:number|null,percentile:number|null)=>{color:string;thickness:number}){
+    const camera=this.mapping.camera(rc);if(!camera)return false;
+    const sx=camera.scale*rc.dpr,tx=camera.x*rc.dpr,ty=y*rc.dpr;
+    ctx.save();ctx.transform(sx,0,0,1,tx,ty);ctx.lineCap='butt';
+    const paint=(node:Node)=>{
+      const first=style(node.first.usd,node.first.percentile),last=style(node.last.usd,node.last.percentile);
+      // Top-level styles are monotone quantized notional tiers. An interval with
+      // matching endpoint styles can reuse its prebuilt exact union path. This
+      // range tree changes stroke selection, not geometry, when contrast moves.
+      if(node.minLength*sx>=1&&first.color===last.color&&first.thickness===last.thickness){
+        ctx.strokeStyle=first.color;ctx.lineWidth=first.thickness*rc.dpr;ctx.stroke(node.path);return;
+      }
+      if(node.left&&node.right){paint(node.left);paint(node.right);return;}
+      const bucket=node.first;
+      ctx.strokeStyle=first.color;ctx.lineWidth=first.thickness*rc.dpr;
+      ctx.beginPath();
+      for(const span of bucket.spans){ctx.moveTo(span.left,0);ctx.lineTo(Math.max(span.right,span.left+1/sx),0);}
+      ctx.stroke();
+    };
+    if(this.root)paint(this.root);
+    ctx.restore();return true;
+  }
+
+  /** Exact extrema for visible-range contrast, independent of path generation. */
+  extent(from:number,to:number){
+    let min=Infinity,max=0;
+    for(const bucket of this.buckets){if(bucket.usd===null||bucket.usd<=0)continue;
+      if(bucket.spans.some(span=>span.to>=from&&span.from<=to)){min=Math.min(min,bucket.usd);max=Math.max(max,bucket.usd);}
+    }
+    return {min,max};
+  }
+  get paths(){return this.buckets.length;}
+}
