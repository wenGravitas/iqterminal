+const base=1704067200;
+class Path {commands:number[][]=[];moveTo(x:number,y:number){this.commands.push([x,y]);}lineTo(x:number,y:number){this.commands.push([x,y]);}addPath(path:Path){this.commands.push(...path.commands);}}
