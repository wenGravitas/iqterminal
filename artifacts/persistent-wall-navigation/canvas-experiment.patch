+<!doctype html><meta charset="utf-8"><title>Explicit retained-wall renderer fixture</title><canvas width="1200" height="600"></canvas>
+<script type="module">
+import {OrderWallsPrimitive} from '/src/chart/order-walls.ts';
+import {DEFAULT_ORDER_WALLS_SETTINGS} from '/src/feed/order-walls.ts';
+const base=1704067200000;
+window.runWallNavigation=async(retained,segments=2500)=>{
+ const canvas=document.querySelector('canvas'),ctx=canvas.getContext('2d');
+ const settings={...DEFAULT_ORDER_WALLS_SETTINGS,enabled:true,mode:'top-levels',aggregation:'native'};
+ const source=Array.from({length:segments},(_,i)=>{const start=base+(i%120)*900000;return {id:`wall-${i}`,archiveEntryId:`entry-${i}`,epoch:1,side:i%2?'ask':'bid',price:90+(i%200)*.1,start,end:start+900000,peakUsd:1000,meanUsd:500,durationMs:900000,percentile:null,scopePartial:false,startKnown:true,endKnown:true,endReason:'rank-exit',detectionMode:'top-levels',rank:1,valueRunsTruncated:false,valueRuns:Array.from({length:8},(_,j)=>({at:start+j*100000,usd:100+(i%20)*10+j*20,quantity:1,rank:1,percentile:null}))};});
+ let from=0,span=120,low=89,high=111;
+ const rc={timeScale:{visibleRange:()=>({from,to:from+span}),indexToX:i=>(i-from)*1200/span,xToIndex:x=>x*span/1200+from},priceScale:{priceRange:()=>({min:low,max:high}),priceToY:p=>(high-p)*600/(high-low)},dataLayer:{indexToTimeFloat:i=>base/1000+i*900,timeToIndexFloat:t=>(t-base/1000)/900},plotWidth:1200,plotHeight:600,dpr:1,theme:{background:'#000',axisText:'#aaa'}};
+ const p=new OrderWallsPrimitive(settings,900000,true,6,()=>true,false,retained);p.attached({requestUpdate(){}});p.setSnapshot(source,{state:'live',tickSize:.1,lastConfirmedAt:base+120*900000});
+ const begin=performance.now();let frames=0;for(;frames<10000;frames++){ctx.clearRect(0,0,1200,600);p.draw(ctx,rc);if(!p.diagnostics().pendingPaintWork&&p.diagnostics().inputRevision===p.diagnostics().paintedRevision)break;if(frames%20===0)await new Promise(r=>setTimeout(r,0));}
+ const initial=performance.now()-begin,before=p.diagnostics(),times=[],blank=[];
+ for(let i=0;i<90;i++){from=5*Math.sin(i/8);span=110+10*Math.cos(i/8);low=89+Math.sin(i/7);high=111+Math.sin(i/7);ctx.clearRect(0,0,1200,600);const t=performance.now();p.draw(ctx,rc);times.push(performance.now()-t);const pixels=ctx.getImageData(0,0,1200,600).data;blank.push(!pixels.some((v,n)=>n%4===3&&v));await new Promise(r=>requestAnimationFrame(r));}
+ const after=p.diagnostics();p.detached();return {retained,segments,runs:segments*8,initial,initialFrames:frames,before,after,times,blankFrames:blank.filter(Boolean).length,userAgent:navigator.userAgent,dpr:devicePixelRatio};
+};
+</script>
