+import {test} from 'node:test';import assert from 'node:assert/strict';
+import {QueryAdmission} from '../src/query-admission.ts';
+test('HTTP saturation leaves capacity for durable cursor replay',()=>{
+ const a=new QueryAdmission(), releases=Array.from({length:3},()=>a.acquire('http'));
+ assert.ok(releases.every(Boolean));assert.equal(a.acquire('http'),undefined);
+ const replay=a.acquire('stream');assert.ok(replay);assert.equal(a.acquire('stream'),undefined);
+ releases[0]!();assert.equal(a.acquire('http'),undefined);replay!();replay!();assert.ok(a.acquire('http'));assert.ok(a.acquire('stream'));assert.equal(a.acquire('stream'),undefined);
+});
+test('admit one complete heatmap query before any database or worker work',()=>{
+ const a=new QueryAdmission(), heatmap=a.acquire('heatmap');assert.ok(heatmap);
+ assert.equal(a.acquire('heatmap'),undefined);assert.ok(a.acquire('http'));assert.ok(a.acquire('stream'));
+ heatmap!();assert.ok(a.acquire('heatmap'));assert.ok(a.acquire('health'));assert.equal(a.acquire('stream'),undefined);
