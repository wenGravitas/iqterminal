+import {test} from 'node:test';import assert from 'node:assert/strict';
+import {DurableBook,reconstruct,type DepthRecord} from '../src/depth-book.ts';
+import {referenceReconstruct} from './depth-reference.ts';
+const sorted=(r:any)=>({...r,cells:r.cells.toSorted((a:any,b:any)=>a.time-b.time||a.low-b.low)});
+test('lazy row integration is identical across quiet rows, same-time changes, gaps, epochs and checkpoints',()=>{
+ for(let seed=1;seed<=12;seed++){
+  let random=seed;const rand=()=>{random=(Math.imul(random,1664525)+1013904223)>>>0;return random/4294967296;};
+  const book=new DurableBook(),records:DepthRecord[]=[];let cursor=0,epoch=1,at=1000,seq=10;
+  const checkpoint=()=>{book.snapshot({lastUpdateId:seq,bids:[['100','2'],['90','0'],['70','3.00000001']],asks:[['110','4'],['120','5']]},epoch,at);book.bridged=true;records.push({cursor:++cursor,epoch,at,kind:'checkpoint',payload:book.save()});};checkpoint();
+  for(let i=0;i<220;i++){
+   at+=[0,0,100,700,2500][Math.floor(rand()*5)]!;
+   if(i===70||i===140){records.push({cursor:++cursor,epoch,at,kind:'gap',payload:{reason:'test continuity gap'}});at+=1700;epoch++;checkpoint();continue;}
+   const levels=()=>Array.from({length:1+Math.floor(rand()*4)},()=>[(50+Math.floor(rand()*101)).toFixed(1),rand()<.2?'0':(rand()*9).toFixed(8)] as [string,string]);
+   const payload={e:'depthUpdate' as const,s:'BTCUSDT' as const,E:at,T:at,U:seq+1,u:seq+1,pu:seq,b:levels(),a:levels()};seq++;book.apply(payload,at);records.push({cursor:++cursor,epoch,at,kind:'delta',payload});
+   if(i%43===0)records.push({cursor:++cursor,epoch,at,kind:'checkpoint',payload:book.save()});
+   if(i%37===0)records.push(records.at(-1)!);
+  }
+  for(const mode of ['average','peak','last'] as const)for(const timeMs of [1000,5000,60000])for(const from of [1000,1700,17000]){
+   const p={from,to:at+3000,low:50,high:160,rowPrice:10,timeMs,mode};
+   assert.deepEqual(sorted(reconstruct(records,p,at+1000)),sorted(referenceReconstruct(records,p,at+1000)),`seed ${seed}, ${mode}, ${timeMs}, ${from}`);
+  }
+ }
+});
+test('a repeated sequence with a new record cursor cannot change quantities',()=>{
+ const b=new DurableBook();b.snapshot({lastUpdateId:10,bids:[['100','2']],asks:[['110','4']]},1,1000);
+ const rows:DepthRecord[]=[{cursor:1,epoch:1,at:1000,kind:'checkpoint',payload:b.save()},{cursor:2,epoch:1,at:1500,kind:'delta',payload:{U:10,u:10,pu:9,b:[['100','999']],a:[]}}];
+ const out=reconstruct(rows,{from:1000,to:2000,low:90,high:120,rowPrice:10,timeMs:1000,mode:'average'},2000);assert.equal(out.cells.find(c=>c.low===100)?.bid,2);
+});
