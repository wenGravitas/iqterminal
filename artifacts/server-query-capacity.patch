+/** Bound expensive HTTP work and leave one of four slots available for cursor replay. */
+export class QueryAdmission {
+ private active=0; private heatmaps=0;
+ acquire(kind:'http'|'heatmap'|'stream'|'health'): (()=>void)|undefined {
+  if(this.active >= (kind==='http'||kind==='heatmap'?3:4) || (kind==='heatmap'&&this.heatmaps)) return;
+  this.active++; if(kind==='heatmap')this.heatmaps++;
+  let released=false;
+  return ()=>{if(released)return;released=true;this.active--;if(kind==='heatmap')this.heatmaps--;};
+ }
+}
