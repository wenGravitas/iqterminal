diff --git a/src/wall-preparation-gateway.ts b/src/wall-preparation-gateway.ts
index fa723c7..ee49112 100644
--- a/src/wall-preparation-gateway.ts
+++ b/src/wall-preparation-gateway.ts
@@ -67,3 +67,20 @@ async function discoverResolvedAndPrepareWallView(root:string,projectionRoot:str
   throw error;
  }
 }
+
+/** Reuse the ordinary validated reader admission before returning ready metadata.
+ * Older clients omit the opt-in and retain the separate POST contract. */
+export async function retainDiscoveredWallReader(data:any,consumer:string|undefined,enabled:boolean,signal?:AbortSignal,command:typeof wallPreparationCommand=wallPreparationCommand){
+ if(consumer!==undefined&&!consumerValid(consumer))throw Error('Invalid discovery wall reader consumer');
+ if(data.state!=='ready'||!enabled)return data;
+ const readerLease:any={version:1,leaseMs:15000};
+ if(consumer){
+  const canonicalKey=(data.representation==='projection-v1'?data.sourceSnapshot:data.manifest)?.key;
+  const projectionKey=data.projection?.manifest?.key;
+  try{
+   readerLease.acquired={...await command('/retain',{consumer,canonicalKey,...(projectionKey?{projectionKey}:{})},signal),consumer};
+   signal?.throwIfAborted();
+  }catch(error){void command('/release',{consumer}).catch(()=>{});throw error;}
+ }
+ return {...data,readerLease};
+}
