{
  "name": "terminal-t0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:staging": "VITE_DATA_MODE=staging vite --mode staging --host 127.0.0.1",
    "tunnel:staging": "bash scripts/staging-tunnel.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "probe:hyperliquid-reconnect": "node scripts/hyperliquid-public-reconnect-probe.mjs",
    "bench": "node scripts/bench.mjs",
    "smoke:live": "node scripts/live.mjs",
    "smoke:live-spot": "node scripts/live-spot.mjs",
    "bench:order-wall-top-levels": "node scripts/order-wall-top-levels-bench.mjs"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "0.33.3",
    "@noble/hashes": "2.4.0",
    "decimal.js": "10.6.0",
    "dockview-core": "8.4.1",
    "openalgo-charts": "2.6.0",
    "openalgo-script": "0.8.1",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22.19.0"
  }
}
