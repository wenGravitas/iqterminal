+// Preserved pre-optimization replay oracle for equivalence tests only.
+import {DurableBook,validateHeatmap,type DepthRecord,type HeatmapRequest} from '../src/depth-book.ts';
+/** Time integration of simultaneous price sums; missing durations never become zeros. */
+export function referenceReconstruct(records:DepthRecord[],p:HeatmapRequest,headAt:number){
+ validateHeatmap(p);const book=new DurableBook();let values:Map<number,any>|undefined;const units=(v:string)=>{const [a,b='']=v.split('.');return BigInt(a+b.padEnd(8,'0'));};let valid=false;let at=p.from;const cells=new Map<string,any>();const spans:any[]=[];
+ const integrate=(end:number,instant=false)=>{const from=Math.max(at,p.from),to=instant?Math.min(from+1,p.to,headAt):Math.min(end,p.to,headAt);if(!valid||to<=from)return;
+  const first=Math.floor(p.low/p.rowPrice),last=Math.ceil(p.high/p.rowPrice);if(!values){values=new Map<number,any>();
+  for(let row=first;row<last;row++)values.set(row,{bid:0n,ask:0n,bidQuote:0n,askQuote:0n,bidKnown:0,askKnown:0});
+  for(const [side,map] of [['bid',book.bids],['ask',book.asks]] as const)for(const [price,q] of map){const value=Number(price),row=Math.floor(value/p.rowPrice+1e-8),v=values.get(row);if(v){v[side]+=units(q);v[side+'Quote']+=units(price)*units(q);v[side+'Known']++;}}}
+  for(let t=from;t<to;){const start=Math.floor(t/p.timeMs)*p.timeMs,until=Math.min(to,start+p.timeMs),dt=instant?0:until-t;
+   for(const [row,v] of values){const low=row*p.rowPrice,high=low+p.rowPrice;const bidComplete=low>=book.bidFloor,askComplete=high<=book.askCeiling+.0000001;
+    if(!bidComplete&&!askComplete&&!v.bidKnown&&!v.askKnown)continue;
+    const key=start+':'+row;let c=cells.get(key);if(!c){c={time:start,low,high,bid:0n,ask:0n,bidQuote:0n,askQuote:0n,bidPeak:0n,askPeak:0n,bidQuotePeak:0n,askQuotePeak:0n,bidLast:0n,askLast:0n,bidQuoteLast:0n,askQuoteLast:0n,bidDuration:0,askDuration:0,bidCompleteDuration:0,askCompleteDuration:0,epochs:new Set<number>()};cells.set(key,c);}
+    for(const side of ['bid','ask'] as const){if((side==='bid'?bidComplete:askComplete)||v[side+'Known']){c[side]+=v[side]*BigInt(dt);c[side+'Quote']+=v[side+'Quote']*BigInt(dt);if(v[side]>c[side+'Peak'])c[side+'Peak']=v[side];if(v[side+'Quote']>c[side+'QuotePeak'])c[side+'QuotePeak']=v[side+'Quote'];c[side+'Last']=v[side];c[side+'QuoteLast']=v[side+'Quote'];c[side+'Duration']+=dt;}if(side==='bid'?bidComplete:askComplete)c[side+'CompleteDuration']+=dt;}
+    c.epochs.add(book.epoch);
+   }t=until;
+  }
+ };
+ const seen=new Set<string>();for(const r of records){const key=r.kind+':'+r.cursor;if(seen.has(key))continue;seen.add(key);if(r.at>p.to)break;integrate(r.at);at=r.at;
+  if(r.kind==='snapshot'||r.kind==='checkpoint'){book.restore(r.payload);values=undefined;book.bridged=r.kind!=="snapshot";valid=true;spans.push({epoch:r.epoch,from:Math.max(r.at,p.from),bidFloor:book.bidFloor,askCeiling:book.askCeiling});}
+  else if(r.kind==='gap'){valid=false;spans.push({epoch:r.epoch,from:r.at,gap:r.payload.reason});}
+  else {if(!valid)continue;
+   if(values)for(const [side,map,levels] of [['bid',book.bids,r.payload.b],['ask',book.asks,r.payload.a]] as const){const changed=new Map<string,string>(levels);for(const [price,q] of changed){const v=values.get(Math.floor(Number(price)/p.rowPrice+1e-8));if(!v)continue;const difference=units(q)-units(map.get(price)??'0');v[side]+=difference;v[side+'Quote']+=units(price)*difference;if(!map.has(price))v[side+'Known']++;}}
